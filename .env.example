# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scheduled jobs only (snapshot, chain verification, invite acceptance).
# Never expose to the browser — it bypasses all row level security.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for cron-triggered route handlers.
CRON_SECRET=

# Where the daily audit chain-head hash is mailed (§10.5).
# This is the cheap external anchor: a record of the chain head held somewhere
# the database administrator does not control, so altered history can be
# disproved later.
AUDIT_ANCHOR_EMAIL=

# Base URL used to build invite acceptance links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
